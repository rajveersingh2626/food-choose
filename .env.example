# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-crons-and-admin

# Client-side Vite Fallbacks (if using Vite frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_API_KEY=your-gemini-api-key

# Application & Cron Protection
CRON_SECRET=your-secure-random-cron-secret
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Proactive Alerts (Twilio WhatsApp or n8n Webhook)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886
N8N_ALERT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/food-alert
