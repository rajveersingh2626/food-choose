{
  "id": "suhanu-food-ai",
  "name": "Suhanu's Culinary Companion",
  "short_name": "Suhanu Food",
  "description": "AI-powered personal culinary companion, smart pantry tracker, and weekly meal planner.",
  "start_url": "/#/mood",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#FBF7F8",
  "theme_color": "#E7829A",
  "categories": ["food", "lifestyle", "productivity", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/#/pantry",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "receipt_image",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
